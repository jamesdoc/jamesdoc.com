<h1>Let's work together</h1>

<div class="bio">
  <img
    src="/_assets/img/face.jpg"
    alt="Headshot photo of James Doc"
    loading="lazy"
    eleventy:widths="150,300"
  />

  <div class="bio__text">
    <p>
      I’m James, a developer and designer based in London, UK. For the last
      {{ (employment | sort(false, false, "start") | first).start | yearsSince }}
      years, I’ve been working in teams building accessible and performant
      digital tools and services for businesses, charities, and agencies such as
      the V&amp;A, Dyson, Nespresso, Alpha International, Beacon CRM
      and&nbsp;more…
    </p>
    <ul class="bio__text__links">
      <li><a href="#professional">Professional</a></li>
      <li><a href="#education">Education</a></li>
      <li><a href="#voluntary">Voluntary</a></li>
    </ul>
  </div>
</div>

<h2 id="professional" class="sectionHeading roleSection">Professional</h2>

{% for job in employment %}
<div class="role">
  {% include "partials/role.njk" %}

  {% if job.summary and job.info %}
  <details class="role__details">
    <summary>{{ job.summary }} <span>More…</span></summary>
    <ul>
      {% for infoline in job.info %}
      <li>{{ infoline | safe }}</li>
      {% endfor %}
    </ul>
  </details>
  {% endif %} {% if job.summary and job.info == undefined %}
  <div class="role__details">
    <p>{{ job.summary }}</p>
  </div>
  {% endif %}
</div>
{% endfor %}

<h2 id="education" class="sectionHeading roleSection">Education</h2>

{% for job in education %}
<div class="role">
  {% include "partials/role.njk" %}
</div>
{% endfor %}

<h2 id="voluntary" class="sectionHeading roleSection">Voluntary</h2>

<div class="roleGrid">
  {% for job in volunteering %}
  <div class="role role--compact">
    {% include "partials/role.njk" %}
  </div>
  {% endfor %}
</div>

